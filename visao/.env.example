# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados da conta do Adafruit IO.
# O ".env" NÃO vai para o GitHub (está no .gitignore). Nunca coloque a chave real neste arquivo de exemplo.
# Onde achar: io.adafruit.com -> ícone de chave amarela ("My Key").

ADAFRUIT_IO_USERNAME=seu_usuario_aqui
ADAFRUIT_IO_KEY=sua_chave_aqui
